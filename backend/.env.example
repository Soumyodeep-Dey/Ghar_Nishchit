PORT=5000
NODE_ENV=development
SHUTDOWN_TIMEOUT_MS=10000
METRICS_ENABLED=false
METRICS_TOKEN=replace-with-a-long-random-monitoring-token
RUN_OUTBOX_WORKER=true
OUTBOX_POLL_INTERVAL_MS=10000
OUTBOX_LEASE_DURATION_MS=60000
OUTBOX_RETRY_BASE_DELAY_MS=10000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017
NEONDB_URL=postgresql://user:password@host/database
NEON_QUERY_TIMEOUT_MS=10000
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Used only by `npm run create-admin`; public registration cannot create admins.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_PHONE=0000000000
